rules_version = '2';
// Template. In the Firebase console, replace FAMILY_EMAIL with the family's Google account(s).
// Also enable Authentication > Sign-in method > Anonymous (used to pair an Xbox with a 6-letter code).
service cloud.firestore {
  match /databases/{database}/documents {
    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['FAMILY_EMAIL'];
    }
    function isPairedWith(uid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(uid)/devices/$(request.auth.uid));
    }
    match /users/{uid}/{document=**} {
      allow read, write: if (isFamily() && request.auth.uid == uid) || isPairedWith(uid);
    }
    match /pairing/{code} {
      allow create: if request.auth != null && request.resource.data.anon == request.auth.uid;
      allow read: if request.auth != null;
      allow update: if isFamily();
      allow delete: if request.auth != null && resource.data.anon == request.auth.uid;
    }
  }
}
